# Copy this file to `.env` and fill in values. `.env` is ignored by git, so your keys stay private.
# Every setting is optional: the app works with free data from football-data.co.uk without any key.

# Where the database lives. Default: a local SQLite file (no installation needed).
# For PostgreSQL (e.g. with docker compose) use:
#   SPORTPRED_DATABASE_URL=postgresql+psycopg://sportpred:sportpred@db:5432/sportpred
SPORTPRED_DATABASE_URL=sqlite:///data/sportpred.db

# Folder for downloaded files, settings and reports.
SPORTPRED_DATA_DIR=data

# Optional: The Odds API key for fresher live odds (free tier: 500 credits/month).
# Get one at https://the-odds-api.com/  — leave empty if you do not have one.
SPORTPRED_ODDS_API_KEY=

# Optional: regions for The Odds API (uk, eu, us, au). Each region costs 1 credit per market per call.
SPORTPRED_ODDS_API_REGIONS=uk,eu
